---
import Layout from "../layouts/Layout.astro";
import { useTranslations } from "../i18n/utils";
import logoLight from "../assets/logo-light.webp";
import sellLogo from "../assets/sell-logo.webp";
import contyLogo from "../assets/conty-logo.webp";

const lang = "en" as const;
const t = useTranslations(lang);
---

<Layout
  title={t("bio.seo.title")}
  description={t("bio.seo.description")}
  keywords={t("bio.seo.keywords")}
  lang={lang}
>
  <div class="bio-bg-glow"></div>

  <div class="bio-container">
    <!-- Language Switcher -->
    <div class="lang-switch-container animate-up delay-0">
      <a href="/es" class="lang-switch-btn" onclick="sessionStorage.setItem('lang-chosen','es')">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="14"
          height="14"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          ><circle cx="12" cy="12" r="10"></circle><line
            x1="2"
            y1="12"
            x2="22"
            y2="12"></line><path
            d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"
          ></path></svg
        >
        <span>Español</span>
      </a>
    </div>

    <!-- Header -->
    <header class="bio-header animate-up delay-0">
      <div class="bio-avatar">
        <img src={logoLight.src} alt="Gadmin" class="bio-avatar-img" />
      </div>
      <h1 class="bio-title">{t("bio.headline")}</h1>
      <p class="bio-subtitle">{t("bio.tagline")}</p>
    </header>

    <!-- Agencies -->
    <div class="bio-ecosystem animate-up delay-1">
      <div class="bio-ecosystem-title">{t("bio.ecosystem.title")}</div>

      <div class="bio-apps-grid">
        <!-- Sell -->
        <a
          href="https://gadmin.app"
          target="_blank"
          rel="noopener"
          class="bio-app-mini sell"
        >
          <svg class="bio-app-mini-ext" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 0 0 3 8.25v10.5A2.25 2.25 0 0 0 5.25 21h10.5A2.25 2.25 0 0 0 18 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25" />
          </svg>
          <div class="bio-app-mini-header">
            <div class="bio-app-mini-icon">
              <img src={sellLogo.src} alt="Gadmin Sell" />
            </div>
            <div class="bio-app-mini-meta">
              <div class="bio-app-mini-name">{t("bio.sell.name")}</div>
              <div class="bio-app-mini-badge">{t("bio.sell.badge")}</div>
            </div>
          </div>
          <p class="bio-app-mini-desc">{t("bio.sell.tagline")}</p>
        </a>

        <!-- Conty -->
        <a
          href="https://gadmin.app"
          target="_blank"
          rel="noopener"
          class="bio-app-mini conty"
        >
          <svg class="bio-app-mini-ext" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 0 0 3 8.25v10.5A2.25 2.25 0 0 0 5.25 21h10.5A2.25 2.25 0 0 0 18 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25" />
          </svg>
          <div class="bio-app-mini-header">
            <div class="bio-app-mini-icon">
              <img src={contyLogo.src} alt="Gadmin Conty" />
            </div>
            <div class="bio-app-mini-meta">
              <div class="bio-app-mini-name">{t("bio.conty.name")}</div>
              <div class="bio-app-mini-badge">{t("bio.conty.badge")}</div>
            </div>
          </div>
          <p class="bio-app-mini-desc">{t("bio.conty.tagline")}</p>
        </a>
      </div>

      <div class="bio-ecosystem-sync">
        {t("bio.ecosystem.sync")}
      </div>
    </div>

    <!-- Bio Links List -->
    <div class="bio-links-list animate-up delay-2">
      <!-- Sell -->
      <a
        href="https://gadmin.app"
        target="_blank"
        rel="noopener"
        class="bio-link-btn primary-sell"
      >
        <div class="bio-link-btn-icon">
          <img src={sellLogo.src} alt="Gadmin Sell" />
        </div>
        <span>{t("bio.links.sell")}</span>
        <svg
          class="bio-link-btn-arrow"
          xmlns="http://www.w3.org/2000/svg"
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          ><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg
        >
      </a>

      <!-- Conty -->
      <a
        href="https://gadmin.app"
        target="_blank"
        rel="noopener"
        class="bio-link-btn primary-conty"
      >
        <div class="bio-link-btn-icon">
          <img src={contyLogo.src} alt="Gadmin Conty" />
        </div>
        <span>{t("bio.links.conty")}</span>
        <svg
          class="bio-link-btn-arrow"
          xmlns="http://www.w3.org/2000/svg"
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          ><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg
        >
      </a>

      <!-- Visitar la web de Gadmin -->
      <a
        href="https://gadmin.app"
        target="_blank"
        rel="noopener"
        class="bio-link-btn brand-gadmin"
      >
        <div class="bio-link-btn-icon">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            ><circle cx="12" cy="12" r="10"></circle><line
              x1="2"
              y1="12"
              x2="22"
              y2="12"></line><path
              d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"
            ></path></svg
          >
        </div>
        <span>{t("bio.links.gadmin")}</span>
        <svg
          class="bio-link-btn-arrow"
          xmlns="http://www.w3.org/2000/svg"
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          ><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg
        >
      </a>

      <a href="mailto:contacto@gadmin.app" class="bio-link-btn brand-gadmin">
        <div class="bio-link-btn-icon">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            ><rect width="20" height="16" x="2" y="4" rx="2"></rect><path
              d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path></svg
          >
        </div>
        <span>{t("bio.links.email")}</span>
        <svg
          class="bio-link-btn-arrow"
          xmlns="http://www.w3.org/2000/svg"
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          ><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg
        >
      </a>

      <!-- Ir a Tik Tok -->
      <a
        href="https://www.tiktok.com/@gadmin.app"
        target="_blank"
        rel="noopener"
        class="bio-link-btn tiktok-btn"
      >
        <div class="bio-link-btn-icon">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            ><path d="M9 12a4 4 0 1 0 4 4V4a5 5 0 0 0 5 5"></path></svg
          >
        </div>
        <span>{t("bio.links.tiktok")}</span>
        <svg
          class="bio-link-btn-arrow"
          xmlns="http://www.w3.org/2000/svg"
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          ><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg
        >
      </a>

      <!-- Instagram de Sell -->
      <a
        href="https://www.instagram.com/gadminsell"
        target="_blank"
        rel="noopener"
        class="bio-link-btn instagram-btn instagram-sell"
      >
        <div class="bio-link-btn-icon">
          <img src={sellLogo.src} alt="Gadmin Sell" />
        </div>
        <span>{t("bio.links.instagramSell")}</span>
        <svg
          class="bio-link-btn-arrow"
          xmlns="http://www.w3.org/2000/svg"
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          ><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg
        >
      </a>

      <!-- Ir a Instagram -->
      <a
        href="https://www.instagram.com/gadmin.app/"
        target="_blank"
        rel="noopener"
        class="bio-link-btn instagram-btn"
      >
        <div class="bio-link-btn-icon">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            ><rect width="20" height="20" x="2" y="2" rx="5" ry="5"></rect><path
              d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path><line
              x1="17.5"
              y1="6.5"
              x2="17.51"
              y2="6.5"></line></svg
          >
        </div>
        <span>{t("bio.links.instagram")}</span>
        <svg
          class="bio-link-btn-arrow"
          xmlns="http://www.w3.org/2000/svg"
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          ><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg
        >
      </a>
    </div>
  </div>

  <script>
    // Auto-redirect Spanish-language users to /es
    // Skip if they have already been redirected or explicitly chose English
    const hasChosen = sessionStorage.getItem("lang-chosen");
    if (!hasChosen) {
      const lang = navigator.language || (navigator as any).userLanguage || "";
      if (lang.toLowerCase().startsWith("es")) {
        sessionStorage.setItem("lang-chosen", "es");
        window.location.replace("/es");
      }
    }
  </script>

  <script>
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) {
            e.target.classList.add("visible");
            observer.unobserve(e.target);
          }
        });
      },
      { threshold: 0.1 },
    );
    document
      .querySelectorAll(".animate-up")
      .forEach((el) => observer.observe(el));
  </script>
</Layout>
